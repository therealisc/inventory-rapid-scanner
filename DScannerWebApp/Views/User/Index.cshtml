@model List<Order>

<h2 style="color:steelblue;">My orders</h2>

<p>List of orders that were send and payed successfully.</p>

<table id="table" class="table table-hover table-striped">
    <thead>
        <tr>
            <th>Order Id</th>
            <th>Order date</th>
            <th>Order Total Price</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
        <tr id="@item.Id">
            <td>@item.Id</td>
            <td>@item.OrderDate</td>
            <td>@item.TotalPrice</td>
        </tr>
        }
    </tbody>
</table>

