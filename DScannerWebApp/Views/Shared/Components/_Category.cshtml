@model Category


@{
string action = "";
var isNew = (bool)ViewBag.IsNew;
if (isNew)
action = "/Category/New";
else
action = string.Format("/Category/Edit/{0}", Model.Id);
}


<div class="row">
    <div class="col-md-1"></div>
    <div class="col-md-10 table-round bg-light shadow">

        <br />
        <h4>Category</h4>
        <br />

        <div class="col-xl-12">

            <input asp-for="Id" hidden />

            <form action="@action" method="post" enctype="multipart/form-data">

                <div asp-validation-summary="All" class="text-danger"></div>
                <br />
                <div class="row">

                    <div class="col-sm-12 col-lg-12">

                        <div class="row">

                            <div class="col-xs-12 col-sm-2">
                                <label class="control-label font-weight-bold">Category name</label>
                            </div>

                            <div class="col-xs-12 col-sm-4">
                                <input asp-for="CategoryName" class="form-control" /><br />
                                <span asp-validation-for="CategoryName" class="text-danger"></span>
                            </div>
                        </div>


                        <br />


                    <div class="row mb-4">

                        @await Html.PartialAsync(@"_CancelSaveBtn.cshtml")
                    </div>

                </div>

            </form>

        </div>

    </div>
</div>
